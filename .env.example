# Nusxa oling: cp .env.example .env
# Haqiqiy .env fayli .gitignore da — u hech qachon push qilinmaydi.

# --- Generatsiya provayderlari (birortasi yetadi) ---
HIGGSFIELD_API_KEY=
FAL_API_KEY=
REPLICATE_API_TOKEN=

# --- Ovoz ---
ELEVENLABS_API_KEY=

# --- Telegram bot (keyinroq kerak bo'ladi) ---
TELEGRAM_BOT_TOKEN=

# --- Sozlamalar ---
KINOAI_OUTPUT_DIR=./output
KINOAI_PROVIDER=dryrun
