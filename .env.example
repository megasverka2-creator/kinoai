# Nusxa oling: cp .env.example .env
# Haqiqiy .env .gitignore da — hech qachon push qilinmaydi.

# --- Telegram (majburiy) ---
TELEGRAM_BOT_TOKEN=

# --- LLM: ssenariy va kadrlar (birortasi) ---
# Ikkalasi ham bo'sh bo'lsa demo rejim ishlaydi
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=

# --- Media: rasm va video ---
# Bo'sh bo'lsa FFmpeg bilan placeholder yasaladi (bepul sinov)
FAL_API_KEY=

# Model ID lar — provayder o'zgartirsa shu yerda tuzatiladi.
# ISHLATISHDAN OLDIN provayder hujjatidan tekshiring.
FAL_IMAGE_MODEL=
FAL_VIDEO_MODEL=

# --- Narx (xarajat hisoblash uchun) ---
PRICE_PER_IMAGE=0.04
PRICE_PER_VIDEO_SECOND=0.22

# --- Budjet chegarasi ---
FAST_VIDEO_BUDGET_USD=20
